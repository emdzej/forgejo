{{/* Access tokens and SSH keys of a bot, managed by a site administrator or an organization
   owner. Requires .BotCredentialsLink, .TokensWithResources and .BotKeys,
   see routers/web/user/setting/bot_credentials.go. */}}
<h4 class="ui top attached header">
	{{ctx.Locale.Tr "settings.manage_access_token"}}
	<div class="ui right">
		<a class="ui primary tiny button" href="{{.BotCredentialsLink}}/tokens/new">{{ctx.Locale.Tr "settings.new_access_token"}}</a>
	</div>
</h4>
<div class="ui attached segment">
	<div class="flex-list" id="bot-tokens">
		<div class="flex-item">
			{{ctx.Locale.Tr "bots.tokens_desc"}}
		</div>
		{{range .TokensWithResources}}
			<div class="flex-item">
				<div class="flex-item-leading">
					<span class="text {{if .Token.HasRecentActivity}}green{{end}}" {{if .Token.HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.token_state_desc"}}"{{end}}>
						{{svg "fontawesome-send" 32}}
					</span>
				</div>
				<div class="flex-item-main">
					<details>
						<summary><span class="flex-item-title">{{.Token.Name}}</span></summary>
						{{if .Token.ResourceAllRepos}}
							<p class="tw-my-1">{{ctx.Locale.Tr "settings.repo_and_org_access"}}:</p>
							{{if .Token.DisplayPublicOnly}}
								{{ctx.Locale.Tr "settings.permissions_public_only"}}
							{{else}}
								{{ctx.Locale.Tr "settings.permissions_access_all"}}
							{{end}}
						{{else}}
							<p class="tw-my-1">{{ctx.Locale.Tr "settings.specific_repo_access"}}:</p>
							<ul class="tw-my-1">
								{{range .Repositories}}
									<li><a href="{{.HTMLURL}}">{{.FullName}}</a></li>
								{{end}}
							</ul>
						{{end}}
						<p class="tw-my-1">{{ctx.Locale.Tr "settings.permissions_list"}}</p>
						<ul class="tw-my-1">
						{{range .Token.Scope.StringSlice}}
							{{if (ne . $.AccessTokenScopePublicOnly)}}
								<li>{{.}}</li>
							{{end}}
						{{end}}
						</ul>
					</details>
					<div class="flex-item-body">
						<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .Token.CreatedUnix)}} — {{svg "octicon-info"}} {{if .Token.HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if .Token.HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort .Token.UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}</p>
					</div>
				</div>
				<div class="flex-item-trailing">
					<button class="ui primary tiny button delete-button" data-modal-id="regenerate-bot-token" data-url="{{$.BotCredentialsLink}}/tokens/regenerate" data-id="{{.Token.ID}}">
						{{svg "octicon-issue-reopened" 16 "tw-mr-1"}}
						{{ctx.Locale.Tr "settings.regenerate_token"}}
					</button>
					<button class="ui red tiny button delete-button" data-modal-id="delete-bot-token" data-url="{{$.BotCredentialsLink}}/tokens/delete" data-id="{{.Token.ID}}">
						{{svg "octicon-trash" 16 "tw-mr-1"}}
						{{ctx.Locale.Tr "settings.delete_token"}}
					</button>
				</div>
			</div>
		{{end}}
	</div>
</div>

<h4 class="ui top attached header">
	{{ctx.Locale.Tr "settings.manage_ssh_keys"}}
	<div class="ui right">
		<button class="ui primary tiny show-panel toggle button" data-panel="#add-bot-ssh-key-panel">
			{{ctx.Locale.Tr "settings.add_key"}}
		</button>
	</div>
</h4>
<div class="ui attached segment">
	<div class="tw-hidden tw-mb-4" id="add-bot-ssh-key-panel">
		<form class="ui form" action="{{.BotCredentialsLink}}/keys" method="post">
			<div class="field">
				<label for="bot-ssh-key-title">{{ctx.Locale.Tr "settings.key_name"}}</label>
				<input id="bot-ssh-key-title" name="title" required maxlength="50">
			</div>
			<div class="field">
				<label for="bot-ssh-key-content">{{ctx.Locale.Tr "settings.key_content"}}</label>
				<textarea id="bot-ssh-key-content" name="content" class="js-quick-submit" placeholder="{{ctx.Locale.Tr "settings.key_content_ssh_placeholder"}}" required></textarea>
			</div>
			<button class="ui primary button">{{ctx.Locale.Tr "settings.add_key"}}</button>
			<button class="ui hide-panel button" data-panel="#add-bot-ssh-key-panel">{{ctx.Locale.Tr "cancel"}}</button>
		</form>
	</div>
	<div class="flex-list" id="bot-keys">
		<div class="flex-item">
			{{ctx.Locale.Tr "bots.keys_desc"}}
		</div>
		{{range .BotKeys}}
			<div class="flex-item">
				<div class="flex-item-leading">
					<span class="text {{if .HasRecentActivity}}green{{end}}">{{svg "octicon-key" 32}}</span>
				</div>
				<div class="flex-item-main">
					<div class="flex-item-title">{{.Name}}</div>
					<div class="flex-item-body">{{.Fingerprint}}</div>
					<div class="flex-item-body">
						<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}} — {{svg "octicon-info"}} {{if .HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if .HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort .UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}</p>
					</div>
				</div>
				<div class="flex-item-trailing">
					<button class="ui red tiny button delete-button" data-modal-id="delete-bot-key" data-url="{{$.BotCredentialsLink}}/keys/delete" data-id="{{.ID}}">
						{{ctx.Locale.Tr "settings.delete_key"}}
					</button>
				</div>
			</div>
		{{end}}
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="regenerate-bot-token">
	<div class="header">
		{{svg "octicon-issue-reopened" 16 "tw-mr-1"}}
		{{ctx.Locale.Tr "settings.access_token_regeneration"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "settings.access_token_regeneration_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" (dict "ModalButtonColors" "primary")}}
</div>

<div class="ui g-modal-confirm delete modal" id="delete-bot-token">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "settings.access_token_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "settings.access_token_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm"}}
</div>

<div class="ui g-modal-confirm delete modal" id="delete-bot-key">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "settings.ssh_key_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "settings.ssh_key_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm"}}
</div>
